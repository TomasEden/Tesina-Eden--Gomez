# ============================================================
# Senderos Spa — Configuración privada
# Copiar este archivo como ".env" y completar con los valores
# reales. El archivo .env está excluido del repositorio.
# NUNCA subir credenciales al repositorio público.
# ============================================================

# ── URL pública del sitio ──────────────────────────────────
# En XAMPP local: http://localhost/Senderos
# En producción:  https://tudominio.com (usar HTTPS)
SENDEROS_URL=http://localhost/Senderos

# ── Verificación en dos pasos (2FA) ────────────────────────
# Clave secreta para el HMAC de los códigos de verificación.
# Generar una clave aleatoria larga, p. ej. con:
#   php -r "echo bin2hex(random_bytes(32));"
# Obligatoria en producción.
SENDEROS_HMAC_SECRET=

# ── Servidor de correo saliente (SMTP) ─────────────────────
# Gmail: usar contraseña de aplicación (no la contraseña normal).
#   https://myaccount.google.com/apppasswords
# El remitente (FROM) debe ser una dirección autorizada por el
# servidor SMTP; en Gmail debe coincidir con la cuenta o ser un
# alias autorizado.
SENDEROS_SMTP_HOST=smtp.gmail.com
SENDEROS_SMTP_PORT=587
SENDEROS_SMTP_USER=tu_correo@gmail.com
SENDEROS_SMTP_PASS=tu_contraseña_de_aplicacion
SENDEROS_SMTP_FROM=tu_correo@gmail.com
SENDEROS_SMTP_FROM_NAME=Senderos Spa
# tls (recomendado, puerto 587) o ssl (puerto 465)
SENDEROS_SMTP_ENCRIPTACION=tls

# ── Mercado Pago (Checkout Pro) — opcional ─────────────────
# MP_ACCESS_TOKEN=
# MP_PUBLIC_KEY=
# MP_WEBHOOK_SECRET=
# MP_MODE=sandbox
